<Window x:Class="CpuWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CpuWidget"
        Title="CPU Widget"
        Width="300" MinWidth="260" MaxWidth="1600" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Thin invisible strip along each edge; hints with a faint bar on hover. -->
        <Style x:Key="GripStyle" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
        </Style>

        <Style x:Key="GripHintStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="2" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="Fill" Value="#44FFFFFF" />
            <Setter Property="Margin" Value="0,14" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#EE0E1116" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <StackPanel Margin="16,9,16,10">
                <local:MetricPanel x:Name="CpuPanel" Title="CPU" Accent="#5AA9FF" />

                <Border x:Name="Divider" Height="1" Background="#1AFFFFFF" Margin="0,9,0,8" />

                <local:MetricPanel x:Name="GpuPanel" Title="GPU" Accent="#A78BFA" />
            </StackPanel>

            <!-- resize grips -->
            <Border x:Name="LeftGrip" Style="{StaticResource GripStyle}" Tag="L"
                    HorizontalAlignment="Left"
                    MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                    MouseMove="Grip_MouseMove"
                    MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                <Rectangle Style="{StaticResource GripHintStyle}" />
            </Border>

            <Border x:Name="RightGrip" Style="{StaticResource GripStyle}" Tag="R"
                    HorizontalAlignment="Right"
                    MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                    MouseMove="Grip_MouseMove"
                    MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                <Rectangle Style="{StaticResource GripHintStyle}" />
            </Border>
        </Grid>
    </Border>
</Window>
