<Window x:Class="CpuWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CpuWidget"
        Title="CPU Widget"
        Width="300" MinWidth="150" MaxWidth="1600"
        Height="270" MinHeight="180" MaxHeight="1400"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="14" Background="#EE0E1116" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid Margin="14,9,14,8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CpuRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="GpuRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:MetricPanel x:Name="CpuPanel" Grid.Row="0" Title="CPU" Accent="#5AA9FF" />

            <Border x:Name="Divider" Grid.Row="1" Height="1" Background="#1AFFFFFF" Margin="0,9,0,8" />

            <local:MetricPanel x:Name="GpuPanel" Grid.Row="2" Title="GPU" Accent="#A78BFA" />

            <TextBlock x:Name="VersionText" Grid.Row="3" Text="v.0.000" FontSize="8"
                       Foreground="#8FA0B4" Opacity="0.35"
                       HorizontalAlignment="Right" Margin="0,3,0,-1" />
        </Grid>
    </Border>
</Window>
