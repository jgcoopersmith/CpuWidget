<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><!-- pulls in System.Drawing without a package ref -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IconGen</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- The dial is drawn by the widget's own code so the tray icon and app.ico can't drift. -->
  <ItemGroup>
    <Compile Include="..\ThermostatIcon.cs" Link="ThermostatIcon.cs" />
  </ItemGroup>

</Project>
