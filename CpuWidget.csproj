<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CpuWidget</AssemblyName>
    <RootNamespace>CpuWidget</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Keep in step with AppVersion.Display, which the widget shows. -->
    <Version>1.0.54</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <!-- Ship the .ico alongside the exe so shortcuts can point at it directly. Explorer
       caches shortcut icons by path, and a path it has already seen may keep serving a
       stale image after the artwork changes. -->
  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The diagnostic and icon tools are separate projects living in subfolders; keep their
       sources (and their generated AssemblyInfo) out of this project's default globs. -->
  <ItemGroup>
    <Compile Remove="SensorDump\**;IconGen\**" />
    <None Remove="SensorDump\**;IconGen\**" />
    <Page Remove="SensorDump\**;IconGen\**" />
  </ItemGroup>

</Project>
