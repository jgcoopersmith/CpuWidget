<UserControl x:Class="CpuWidget.MetricPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- the graph takes whatever height is left, so a taller widget means taller graphs -->
            <RowDefinition x:Name="GraphRow" Height="*" MinHeight="26" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: device label + device name -->
        <DockPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="CPU" FontSize="10" FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
            <TextBlock x:Name="DeviceNameText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Text="" FontSize="10" Foreground="#8FA0B4" Opacity="0.55"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- big readouts: load % and temperature -->
        <Grid Grid.Row="1" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="UsageText" Text="--" FontSize="27" FontWeight="Light" />
                <TextBlock x:Name="UsageUnitText" Text="%" FontSize="12" Margin="2,0,0,5"
                           VerticalAlignment="Bottom" Opacity="0.6" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="TempText" Text="--" FontSize="27" FontWeight="Light"
                           Foreground="#FF7A45" />
                <TextBlock x:Name="TempUnitText" Text="°C" FontSize="12" Margin="2,0,0,5"
                           VerticalAlignment="Bottom" Foreground="#FF7A45" Opacity="0.6" />
            </StackPanel>
        </Grid>

        <!-- history graph -->
        <Border x:Name="GraphBorder" Grid.Row="2" Margin="0,4,0,3" CornerRadius="5" Background="#14FFFFFF"
                ClipToBounds="True" SizeChanged="Graph_SizeChanged"
                MouseEnter="Graph_MouseEnter" MouseLeave="Graph_MouseLeave">
            <Canvas>
                <Polygon x:Name="UsageFill" />
                <Polyline x:Name="UsageLine" StrokeThickness="1.4" StrokeLineJoin="Round" />
                <Polyline x:Name="TempLine" Stroke="#FF7A45" StrokeThickness="1.2"
                          StrokeLineJoin="Round" Opacity="0.85" StrokeDashArray="3 2" />
            </Canvas>
        </Border>

        <!-- footer: peak temperature, clock, hottest sensor, power, memory -->
        <DockPanel Grid.Row="3">
            <DockPanel.Resources>
                <!-- borderless reset button; the glyph carries it -->
                <Style x:Key="ResetButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="#8FA0B4" />
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Padding" Value="2,0" />
                    <Setter Property="Margin" Value="2,0,0,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="ToolTip" Value="Reset peak temperature" />
                    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Resources>

            <!-- peak load, sitting under the load figure at the far left -->
            <StackPanel x:Name="MaxLeftPanel" DockPanel.Dock="Left" Orientation="Horizontal"
                        Margin="0,0,8,0" ToolTip="Peak load">
                <TextBlock x:Name="MaxTextLeft" Text="" FontSize="10"
                           Foreground="#8FA0B4" Opacity="0.7" VerticalAlignment="Center" />
                <Button x:Name="ResetLeft" Content="↻" FontSize="10"
                        Style="{StaticResource ResetButtonStyle}" Click="ResetPeakLoad_Click" />
            </StackPanel>

            <!-- peak temperature, sitting under the temperature at the far right -->
            <StackPanel x:Name="MaxRightPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                        Margin="8,0,0,0" ToolTip="Peak temperature">
                <TextBlock x:Name="MaxTextRight" Text="" FontSize="10"
                           Foreground="#8FA0B4" Opacity="0.7" VerticalAlignment="Center" />
                <Button x:Name="ResetRight" Content="↻" FontSize="10"
                        Style="{StaticResource ResetButtonStyle}" Click="ResetPeakTemp_Click" />
            </StackPanel>

            <TextBlock x:Name="DetailText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Text="" FontSize="10" Foreground="#8FA0B4" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="ClockTextBlock" Text="" FontSize="10"
                       Foreground="#8FA0B4" Opacity="0.7" />
        </DockPanel>
    </Grid>
</UserControl>
